# Copy to backend/.env (or export these variables in your shell). Placeholders only.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///backend/db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional provider credentials belong on the backend only; keep empty in local demo.
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
# Mobile Money escrow callbacks and configurable provider endpoints.
MOBILE_MONEY_WEBHOOK_SECRET=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_COLLECTION_URL=https://proxy.momoapi.mtn.com/collection/v1_0/requesttopay
MTN_MOMO_TOKEN_URL=https://proxy.momoapi.mtn.com/collection/token
MTN_MOMO_DISBURSEMENT_URL=https://proxy.momoapi.mtn.com/disbursement/v1_0/transfer
MTN_MOMO_TRANSFER_API_USER=
MTN_MOMO_TRANSFER_API_KEY=
MTN_MOMO_TRANSFER_SUBSCRIPTION_KEY=
MTN_MOMO_ENVIRONMENT=sandbox
MOBILE_MONEY_SANDBOX=true
AIRTEL_MONEY_COLLECTION_URL=
AIRTEL_MONEY_DISBURSEMENT_URL=
AIRTEL_MONEY_TOKEN_URL=
# Order receipt email (leave EMAIL_HOST blank to print previews to the API console locally).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Imena <no-reply@imena.rw>
# SMS adapter endpoint: accepts POST JSON {to, from, message}; provider token is sent as Bearer auth.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER_ID=Imena
# Optional OpenAI-compatible AI guidance provider (credentials stay on the backend).
AI_GUIDANCE_API_URL=
AI_GUIDANCE_API_KEY=
AI_GUIDANCE_MODEL=gpt-4o-mini
